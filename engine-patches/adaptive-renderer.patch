+                int fx = dst_x + (7 - bit);
+                if (fx < 0 || fx >= out_w) continue;
+                size_t off = (size_t)py * out_w + fx;
+                if (priority && bg_opaque && bg_opaque[off]) continue;
+                uint8_t nes_color = g_ppu_pal[(spr_pal * 4 + color_idx) & 0x1F] & 0x3F;
+                out[off] = g_nes_palette[nes_color];
+            }
+        }
+    }
+}
