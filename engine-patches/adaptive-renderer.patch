+    render_frame_native(s_native_scratch);
+    s_custom_native_pass=0;
+    g_render_width = save_w; g_widescreen_left = save_l; g_widescreen_right = save_r;
+    g_ws_eff_left = save_el; g_ws_eff_right = save_er;
