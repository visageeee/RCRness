+}
+
+static const uint32_t *matching_block(const CrtFilterCache *cache, const uint32_t *src,
+                                      int x, int y, int x0, int y0, int w, int h) {
+    static const int shifts[] = {0, 2, -2, 4, -4, 6, -6, 8, -8};
+    int width = cache->width;
+    int pos = y0 * width + x0;
+    for (unsigned j = 0; j < sizeof shifts / sizeof shifts[0]; j++) {
+        int dx = shifts[j];
+        /* A block clipped at the real screen edge needs that same clamp. */
+        if (dx && (x0 == 0 || x0 + w == width || x0 + dx < 0 || x0 + w + dx > width))
+            continue;
+        for (int age = 0; age < 2; age++) {
+            int index = age == 0 ? 1 - cache->next : cache->next;
+            const CrtFrame *old = &cache->history[index];
+            if (old->valid && same_patch(src + pos, old->picture + (pos + dx), width, w, h))
+                return old->glass + (y * 3 * width + x + dx) * 3;
+        }
+    }
+    return NULL;
+}
+
+void crt_filter_apply_cached(CrtFilterCache *cache, const uint32_t *src,
+                             int source_width, int height, int width,
+                             uint32_t *dst, uint32_t *scratch) {
+    if (!src || !dst || !scratch || source_width <= 0 || width <= 0 || height <= 0) return;
+    if (!cache || !prepare_history(cache, width, height)) {
+        crt_filter_apply_3x(src, source_width, height, width, dst, scratch);
+        return;
+    }
+
+    CrtFrame *current = &cache->history[cache->next];
+    /* scratch holds the full filter output on the uncached path. Reuse its
+     * beginning for aspect correction while rendering individual patches. */
+    if (source_width != width) {
+        for (int y = 0; y < height; y++)
+            for (int x = 0; x < width; x++)
+                scratch[y * width + x] = sample_scaled(src, source_width, width, y, x);
+        src = scratch;
+    }
+
+    if (!cache->history[1 - cache->next].valid) {
+        crt_filter_apply_3x(src, width, height, width, dst, current->glass);
+    } else {
+        uint32_t input[PATCH * PATCH], beam[PATCH * PATCH * 9], blur[PATCH * PATCH * 9];
+        for (int y = 0; y < height; y += TILE) {
+            for (int x = 0; x < width; x += TILE) {
+                int tile_w = width - x < TILE ? width - x : TILE;
+                int tile_h = height - y < TILE ? height - y : TILE;
+                int x0 = x ? x - MARGIN : 0, y0 = y ? y - MARGIN : 0;
+                int x1 = width - x - tile_w < MARGIN ? width : x + tile_w + MARGIN;
+                int y1 = height - y - tile_h < MARGIN ? height : y + tile_h + MARGIN;
+                int w = x1 - x0, h = y1 - y0;
+                const uint32_t *result = matching_block(cache, src, x, y, x0, y0, w, h);
+                int pitch = width * 3;
+                if (!result) {
+                    for (int row = 0; row < h; row++)
+                        memcpy(input + row * w, src + (y0 + row) * width + x0, w * sizeof *src);
+                    crt_filter_apply_3x(input, w, h, w, beam, blur);
+                    pitch = w * 3;
+                    result = beam + (y - y0) * 3 * pitch + (x - x0) * 3;
+                }
+                for (int row = 0; row < tile_h * 3; row++)
+                    memcpy(dst + ((y * 3 + row) * width + x) * 3,
+                           result + row * pitch, tile_w * 3 * sizeof *dst);
+            }
+        }
+        memcpy(current->glass, dst, (size_t)width * height * 9 * sizeof *dst);
+    }
+    memcpy(current->picture, src, (size_t)width * height * sizeof *src);
+    current->valid = 1;
+    cache->next = 1 - cache->next;
+}
